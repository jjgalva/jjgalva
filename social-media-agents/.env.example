# ============================================================
#  Social Media Agents — Environment Variables
#  Copy this file to .env and fill in your real values.
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Instagram (Meta Graph API v19.0) ---
# Long-lived User or System User access token with instagram_content_publish,
# instagram_manage_insights permissions
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
# Instagram Business Account ID (numeric string)
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# --- Facebook (Meta Graph API v19.0) ---
# Page access token with pages_manage_posts, pages_read_engagement permissions
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token_here
# Facebook Page ID (numeric string)
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# --- TikTok (Content Posting API v2) ---
# OAuth 2.0 access token with video.upload, video.publish scopes
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
# TikTok open_id returned during OAuth flow
TIKTOK_OPEN_ID=your_tiktok_open_id_here
