# Token de la API de Apify (https://console.apify.com/account/integrations)
# Plan gratuito: $5 USD de créditos mensuales.
# Si se deja vacío, el sistema corre automáticamente en MODO MOCK con la
# campaña sintética pre-generada (data/mock/*.json) — el demo nunca falla.
APIFY_TOKEN=

# Ruta del archivo SQLite (opcional; default: ./data/radar.db)
# RADAR_DB_PATH=./data/radar.db

# Fuerza el modo mock aunque exista token (útil para demos ante cliente)
# RADAR_MOCK=1
